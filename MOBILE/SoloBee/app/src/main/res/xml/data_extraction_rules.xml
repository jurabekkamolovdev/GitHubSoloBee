<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules for API 31+.
   app_prefs saqlaydi: access_token, refresh_token, user_id.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>